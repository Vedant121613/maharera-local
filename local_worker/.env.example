# URL of your Coolify-hosted Express backend (e.g., https://api.yourdomain.com)
SERVER_URL=https://your-coolify-domain.com

# Must match WORKER_AUTH_TOKEN in backend/routes/worker.js
WORKER_AUTH_TOKEN=rera-local-worker-secret-key

# Unique identifier for this local machine instance
WORKER_ID=windows-local-pc-01

# Polling and heartbeat intervals (in seconds)
HEARTBEAT_INTERVAL=10
POLL_INTERVAL=5

# Headless mode for Chrome/Playwright browser (True or False)
HEADLESS=True