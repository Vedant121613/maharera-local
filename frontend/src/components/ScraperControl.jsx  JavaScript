import React, { useState, useEffect } from 'react';
import axios from 'axios';

const API_BASE = process.env.REACT_APP_API_URL || 'http://localhost:5000/api';

export default function ScraperControl() {
  const [district, setDistrict] = useState('Pune');
  const [jobType, setJobType] = useState('LINK_SCRAPER');
  const [startPage, setStartPage] = useState(1);
  const [endPage, setEndPage] = useState(10);
  
  const [jobs, setJobs] = useState([]);
  const [workers, setWorkers] = useState([]);
  const [loading, setLoading] = useState(false);

  // Fetch Jobs and Worker Statuses
  const fetchData = async () => {
    try {
      const [jobsRes, workersRes] = await Promise.all([
        axios.get(`${API_BASE}/jobs`),
        axios.get(`${API_BASE}/jobs/workers`)
      ]);
      if (jobsRes.data.success) setJobs(jobsRes.data.jobs);
      if (workersRes.data.success) setWorkers(workersRes.data.workers);
    } catch (err) {
      console.error('Failed to fetch scraper status:', err);
    }
  };

  useEffect(() => {
    fetchData();
    const interval = setInterval(fetchData, 4000); // Poll status every 4s
    return () => clearInterval(interval);
  }, []);

  // Trigger New Job
  const handleStartScraper = async () => {
    setLoading(true);
    try {
      await axios.post(`${API_BASE}/jobs`, {
        job_type: jobType,
        district,
        start_page: Number(startPage),
        end_page: Number(endPage)
      });
      fetchData();
    } catch (err) {
      alert('Error triggering job: ' + (err.response?.data?.message || err.message));
    } finally {
      setLoading(false);
    }
  };

  // Request Stop
  const handleStopJob = async (jobId) => {
    try {
      await axios.post(`${API_BASE}/jobs/jobs/${jobId}/stop`);
      fetchData();
    } catch (err) {
      alert('Error stopping job: ' + (err.response?.data?.message || err.message));
    }
  };

  const activeWorker = workers.find((w) => w.is_active);

  return (
    <div style={{ padding: '24px', fontFamily: 'sans-serif', maxWidth: '1000px', margin: '0 auto' }}>
      <h2>RERA Scraper Control Panel</h2>

      {/* Local Worker Live Status Badge */}
      <div style={{ padding: '12px 16px', borderRadius: '8px', background: '#f5f5f5', marginBottom: '20px', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
        <div>
          <strong>Local PC Worker Status: </strong>
          {activeWorker ? (
            <span style={{ color: 'green', fontWeight: 'bold' }}>
              🟢 ONLINE ({activeWorker.worker_id} - {activeWorker.status})
            </span>
          ) : (
            <span style={{ color: 'red', fontWeight: 'bold' }}>🔴 OFFLINE (PC Agent Not Running)</span>
          )}
        </div>
        {activeWorker && (
          <small style={{ color: '#666' }}>
            Last heartbeat: {new Date(activeWorker.last_heartbeat).toLocaleTimeString()}
          </small>
        )}
      </div>

      {/* Control Form */}
      <div style={{ border: '1px solid #ddd', borderRadius: '8px', padding: '20px', marginBottom: '24px' }}>
        <h3>Trigger New Scraping Job</h3>
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr 1fr', gap: '12px', marginBottom: '16px' }}>
          <div>
            <label>Scraper Type</label>
            <select value={jobType} onChange={(e) => setJobType(e.target.value)} style={{ width: '100%', padding: '8px' }}>
              <option value="LINK_SCRAPER">Link Scraper (RERA List)</option>
              <option value="DATA_SCRAPER">Data Scraper (Project Details)</option>
            </select>
          </div>

          <div>
            <label>District</label>
            <input type="text" value={district} onChange={(e) => setDistrict(e.target.value)} style={{ width: '100%', padding: '8px' }} />
          </div>

          <div>
            <label>Start Page</label>
            <input type="number" value={startPage} onChange={(e) => setStartPage(e.target.value)} disabled={jobType === 'DATA_SCRAPER'} style={{ width: '100%', padding: '8px' }} />
          </div>

          <div>
            <label>End Page</label>
            <input type="number" value={endPage} onChange={(e) => setEndPage(e.target.value)} disabled={jobType === 'DATA_SCRAPER'} style={{ width: '100%', padding: '8px' }} />
          </div>
        </div>

        <button onClick={handleStartScraper} disabled={loading} style={{ background: '#0070f3', color: '#fff', border: 'none', padding: '10px 20px', borderRadius: '4px', cursor: 'pointer' }}>
          {loading ? 'Dispatching...' : 'Start Scraping Job'}
        </button>
      </div>

      {/* Job Queue Table */}
      <h3>Recent Jobs</h3>
      <table style={{ width: '100%', borderCollapse: 'collapse', border: '1px solid #ddd' }}>
        <thead>
          <tr style={{ background: '#fafafa', textAlign: 'left' }}>
            <th style={{ padding: '8px', border: '1px solid #ddd' }}>ID</th>
            <th style={{ padding: '8px', border: '1px solid #ddd' }}>Type</th>
            <th style={{ padding: '8px', border: '1px solid #ddd' }}>District</th>
            <th style={{ padding: '8px', border: '1px solid #ddd' }}>Progress</th>
            <th style={{ padding: '8px', border: '1px solid #ddd' }}>Status</th>
            <th style={{ padding: '8px', border: '1px solid #ddd' }}>Action</th>
          </tr>
        </thead>
        <tbody>
          {jobs.map((job) => (
            <tr key={job.id}>
              <td style={{ padding: '8px', border: '1px solid #ddd' }}>#{job.id}</td>
              <td style={{ padding: '8px', border: '1px solid #ddd' }}>{job.job_type}</td>
              <td style={{ padding: '8px', border: '1px solid #ddd' }}>{job.district}</td>
              <td style={{ padding: '8px', border: '1px solid #ddd' }}>
                {job.processed_items} / {job.total_items || '-'}
              </td>
              <td style={{ padding: '8px', border: '1px solid #ddd' }}>
                <span style={{
                  padding: '4px 8px',
                  borderRadius: '4px',
                  fontSize: '12px',
                  color: '#fff',
                  background: job.status === 'RUNNING' ? '#22c55e' : job.status === 'PENDING' ? '#eab308' : job.status === 'COMPLETED' ? '#3b82f6' : '#ef4444'
                }}>
                  {job.status}
                </span>
              </td>
              <td style={{ padding: '8px', border: '1px solid #ddd' }}>
                {(job.status === 'RUNNING' || job.status === 'PENDING') && (
                  <button onClick={() => handleStopJob(job.id)} style={{ background: '#ef4444', color: '#fff', border: 'none', padding: '4px 8px', borderRadius: '4px', cursor: 'pointer' }}>
                    Stop
                  </button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}